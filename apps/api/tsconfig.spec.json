{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": ["vitest/globals", "vitest/importMeta", "node", "vitest"],
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": [
    "vitest.config.ts",
    "src/**/*.ts",
    "tests/**/*.spec.ts",
    "tests/**/*.test.ts"
