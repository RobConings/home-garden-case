{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/storybook",
    "lib": ["DOM", "DOM.Iterable", "ES2019"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve"
  },
  "exclude": [
    "app/**/*.spec.ts",
    "app/**/*.test.ts",
    "app/**/*.spec.js",
    "app/**/*.test.js",
    "app/**/*.spec.tsx",
    "app/**/*.test.tsx",
    "app/**/*.spec.jsx",
    "app/**/*.test.jsx",
    "stories/**/*.spec.ts",
    "stories/**/*.test.ts",
    "stories/**/*.spec.tsx",
    "stories/**/*.test.tsx"
  ],
  "include": [
    "stories/**/*.stories.ts",
    "stories/**/*.stories.js",
    "stories/**/*.stories.jsx",
    "stories/**/*.stories.tsx",
    "stories/**/*.stories.mdx",
    ".storybook/*.js",
    ".storybook/*.ts",
    ".storybook/*.tsx"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ],
  "files": [
    "../../node_modules/@nx/react/typings/styled-jsx.d.ts",
    "../../node_modules/@nx/react/typings/cssmodule.d.ts",
    "../../node_modules/@nx/react/typings/image.d.ts"
  ]
}
